// Add "custom/gmail" to modules-right (or wherever you like) in
// ~/.config/waybar/config.jsonc, and merge this block into your
// top-level module config. install.sh prints this snippet and these
// instructions but does not merge it automatically -- config.jsonc is
// hand-maintained (comments, specific ordering) and a script splicing
// JSON into that blindly is more likely to mangle it than help.
//
// - exec/on-click/on-click-right use the bare command name, resolved via
//   PATH, so this works whether the binaries came from install.sh
//   (~/.local/bin) or from an image that bakes them into /usr/bin -- a
//   dev install in ~/.local/bin simply wins on PATH.
// - interval: how often waybar re-runs `status`. This is the ONLY thing
//   that controls polling cadence -- there is no setting inside
//   waybar-gmail itself for it (see src/config.zig).
// - signal: fired by every mark-read/archive/trash action and by a
//   completed `auth` run, so the count updates immediately instead of
//   waiting for the next interval. Must match the SIGRTMIN+N used in
//   `pkill -RTMIN+9 -x waybar` calls elsewhere (install.sh keeps these in
//   sync automatically; if you assign this signal number to a different
//   module too, both will refresh together, which is harmless).
"custom/gmail": {
  "format": " {}",
  "return-type": "json",
  "interval": 60,
  "signal": 9,
  "exec": "waybar-gmail status",
  "on-click": "waybar-gmail click",
  "on-click-right": "waybar-gmail open",
  "tooltip": true,
},
